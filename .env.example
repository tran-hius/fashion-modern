# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME="Blog Cá Nhân Chia Sẻ Video Khóa Học"
APP_ENV=development
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# ==============================================================================
# DATABASE (POSTGRESQL & DOCKER-COMPOSE)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=course_blog

# Async Database URL (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/course_blog

# ==============================================================================
# SECURITY & AUTHENTICATION (JWT)
# ==============================================================================
SECRET_KEY=your_secret_key_here_generate_a_secure_random_string_32_chars
JWT_SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_DAYS=30

# ==============================================================================
# CORS
# ==============================================================================
CORS_ORIGINS=["http://localhost:3000"]

# ==============================================================================
# GOOGLE OAUTH CONFIGURATION
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ==============================================================================
# FRONTEND URL
# ==============================================================================
FRONTEND_URL=http://localhost:5173
