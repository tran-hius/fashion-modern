# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME="Blog Cá Nhân Chia Sẻ Video Khóa Học"
APP_ENV=development
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# ==============================================================================
# DATABASE (POSTGRESQL & DOCKER-COMPOSE)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=course_blog

# Async Database URL (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/course_blog

# ==============================================================================
# SECURITY & AUTHENTICATION (JWT)
# ==============================================================================
SECRET_KEY=your_secret_key_here_generate_a_secure_random_string_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# CORS
# ==============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
